rules_version = '2';

// Virtual Automotive Test Lab（VATL-100 エミュレーター）
//
// エミュレーターはブラウザ内だけで動き、Firestore は使わない。
// 旧 ZooPass（予約アプリ）のデータが残っていても読み書きできないよう、すべて拒否する。

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
