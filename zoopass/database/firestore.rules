rules_version = '2';

// ZooPass（Secure版）Firestore セキュリティルール
//
// サーバー側の処理（Cloud Functions）は使わず、ブラウザから Firestore に直接書き込む。
// そのため「サーバー側での検証」はすべてこのルールで行う。
//
// 予約の作成と取消は、次の2つの書き込みを1回のバッチで同時に行う。
//   1. reservations/{id} の作成（または取消への変更）
//   2. slots/{date} の reserved の加算（または減算）と、lastOp = 予約ID の設定
// 2つのルールが getAfter() で互いの書き込み結果を確認し合うことで、
// 「予約だけ作る」「枠の数だけ書き換える」といった不整合な書き込みを拒否する。

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共通関数 ----------

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function slotPath(date) {
      return /databases/$(database)/documents/slots/$(date);
    }

    function reservationPath(id) {
      return /databases/$(database)/documents/reservations/$(id);
    }

    function isValidDate(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 日本時間で、その日がまだ終わっていない
    function notPast(d) {
      let p = d.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) + duration.value(1, 'd')
        > request.time + duration.value(9, 'h');
    }

    // ---------- 管理者（コンソールから手動で登録） ----------

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- 日別の受付枠 ----------

    match /slots/{date} {
      allow read: if true;

      // 管理者だけが新しい日の枠を作れる（予約数は0から）
      allow create: if isAdmin()
        && isValidDate(date)
        && request.resource.data.keys().hasOnly(['date', 'capacity', 'reserved'])
        && request.resource.data.keys().hasAll(['date', 'capacity', 'reserved'])
        && request.resource.data.date == date
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 100000
        && request.resource.data.reserved == 0;

      // 予約・取消に連動した reserved の増減だけを許可
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reserved', 'lastOp'])
        && request.resource.data.reserved is int
        && request.resource.data.reserved >= 0
        && request.resource.data.reserved <= resource.data.capacity
        && request.resource.data.lastOp is string
        && (slotChangeByCreate(date) || slotChangeByCancel(date));

      allow delete: if false;
    }

    // 同じバッチで予約が新しく作られ、その枚数だけ増えている
    function slotChangeByCreate(date) {
      let id = request.resource.data.lastOp;
      let after = getAfter(reservationPath(id));
      return !exists(reservationPath(id))
        && existsAfter(reservationPath(id))
        && after.data.uid == request.auth.uid
        && after.data.date == date
        && after.data.status == 'active'
        && request.resource.data.reserved - resource.data.reserved == after.data.tickets;
    }

    // 同じバッチで予約が取消に変わり、その枚数だけ減っている
    function slotChangeByCancel(date) {
      let id = request.resource.data.lastOp;
      let before = get(reservationPath(id));
      let after = getAfter(reservationPath(id));
      return before.data.uid == request.auth.uid
        && before.data.date == date
        && before.data.status == 'active'
        && after.data.status == 'cancelled'
        && resource.data.reserved - request.resource.data.reserved == before.data.tickets;
    }

    // ---------- 予約 ----------

    match /reservations/{id} {
      // 本人の予約だけ読める
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'date', 'tickets', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'date', 'tickets', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isValidDate(request.resource.data.date)
        && notPast(request.resource.data.date)
        && request.resource.data.tickets is int
        && request.resource.data.tickets >= 1
        && request.resource.data.tickets <= 10
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        // 同じバッチで枠が正しく加算されていること
        && getAfter(slotPath(request.resource.data.date)).data.lastOp == id
        && getAfter(slotPath(request.resource.data.date)).data.reserved
             == get(slotPath(request.resource.data.date)).data.reserved + request.resource.data.tickets;

      // 本人による「予約中 → 取消済」の変更だけ
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && notPast(resource.data.date)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        // 同じバッチで枠が正しく減算されていること
        && getAfter(slotPath(resource.data.date)).data.lastOp == id
        && getAfter(slotPath(resource.data.date)).data.reserved
             == get(slotPath(resource.data.date)).data.reserved - resource.data.tickets;

      allow delete: if false;
    }

    // ---------- それ以外はすべて拒否 ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
